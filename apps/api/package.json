{
  "name": "@clipforge/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy-preflight.mjs && npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix ../web install && npm --prefix ../web run build",
    "test": "vitest run",
    "verify:secrets": "node scripts/deploy-preflight.mjs --verify-secrets"
  },
  "dependencies": {
    "hono": "^4.10.4",
    "jose": "^6.1.3",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0",
    "vitest": "^3.2.4"
  }
}
