CLIPFORGE_API_BASE_URL=https://your-worker.example.workers.dev
PROCESSOR_SHARED_SECRET=replace-with-a-long-random-secret
PROCESSOR_WORKER_ID=clipforge-worker-1
PROCESSOR_HTTP_TIMEOUT_SECONDS=20
YOUTUBE_DATA_API_KEY=replace-with-youtube-data-api-key
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret
PROCESSOR_SCRATCH_DIR=/var/lib/clipforge/scratch
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
PROCESSOR_FFPROBE_TIMEOUT_SECONDS=30
PROCESSOR_FFMPEG_TIMEOUT_SECONDS=3600
PROCESSOR_MAX_VIDEO_DURATION_SECONDS=43200
PROCESSOR_MAX_AUDIO_BYTES=1500000000
PROCESSOR_FFMPEG_THREADS=2

PROCESSOR_STT_MODEL=base
PROCESSOR_STT_MODEL_CACHE_DIR=/var/cache/clipforge/models
PROCESSOR_STT_CPU_THREADS=2
PROCESSOR_STT_CHUNK_SECONDS=300
PROCESSOR_STT_BEAM_SIZE=1
PROCESSOR_STT_LANGUAGE=
PROCESSOR_STT_CHUNK_TIMEOUT_SECONDS=1800
PROCESSOR_MOMENTS_TIMEOUT_SECONDS=1800
